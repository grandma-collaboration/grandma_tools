# SkyPortal Source Watcher Configuration
# Copy this file and customize the values for your environment

# ====== OWNCLOUD CONFIGURATION (REQUIRED) ======
OWNCLOUD_BASE_URL=https://grandma-owncloud.ijclab.in2p3.fr
OWNCLOUD_USERNAME=your_username_here
OWNCLOUD_TOKEN=your_owncloud_token_here
OWNCLOUD_USER_ID=your_user_id_here
# Path where folders of sources are located in ownCloud
SAVE_PATH=Candidates/Skyportal

# ====== SKYPORTAL CONFIGURATION (REQUIRED) ======
SKYPORTAL_URL=https://skyportal-icare.ijclab.in2p3.fr
SKYPORTAL_TOKEN=your_skyportal_token_here

# ======= STDWEB CONFIGURATION (REQUIRED) ======
STDWEB_URL=http://100.90.108.127:8000
STDWEB_TOKEN=your_stdweb_token_here

# ====== APPLICATION SETTINGS (OPTIONAL) ======

# How often to check for new sources (seconds)
POLL_INTERVAL=60

# What to search for in comments to activate processing
SKYPORTAL_COMMAND=@Process

# SkyPortal group IDs to monitor (comma-separated)
# Group 3 is GRANDNMA
GROUP_IDS=3

# Optional source tag filter (leave empty for no filter)
SOURCE_TAG=

# Optional start time (example: 2025-06-01T00:00:00Z). By default, the start date will be 1 day ago from the script launch
START_TIME= 

# ====== SLACK NOTIFICATIONS (OPTIONAL) ======
# Slack bot token for notifications (leave empty to disable)
SLACK_BOT_TOKEN=

# Service name (used as Slack channel name: #owncloud-folder-service)
SLACK_SERVICE_NAME=owncloud-folder-service